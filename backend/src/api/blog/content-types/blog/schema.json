{
  "kind": "collectionType",
  "collectionName": "blog",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": "CareerXel resource and blog posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "richtext"
    },
    "category": {
      "type": "string",
      "default": "Hiring"
    },
    "readTime": {
      "type": "string",
      "default": "5 min"
    },
    "author": {
      "type": "string",
      "default": "CareerXel Team"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
